{
  "name": "@hestia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/app.ts",
  "types": "src/app.ts",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env src/index.ts",
    "seed": "bun --env-file=../../.env src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hestia/types": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
